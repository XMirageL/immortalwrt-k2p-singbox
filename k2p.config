# 目标硬件平台
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# 移除无线驱动与 Wi-Fi 固件（旁路由省出 3-4MB 空间）
# CONFIG_PACKAGE_kmod-mt7603e is not set
# CONFIG_PACKAGE_kmod-mt7615e is not set
# CONFIG_PACKAGE_mt7603e-firmware is not set
# CONFIG_PACKAGE_mt7615e-firmware is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_hostapd-common is not set

# 移除不必要的拨号与接入组件
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set

# 核心：选择 PassWall 与 sing-box
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_passwall_INCLUDE_Sing_Box=y

# 严禁勾选其它体积庞大的核心，防止固件超过 16MB
# CONFIG_PACKAGE_passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_passwall_INCLUDE_V2ray is not set
# CONFIG_PACKAGE_passwall_INCLUDE_Trojan_Plus is not set
# CONFIG_PACKAGE_passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_passwall_INCLUDE_Shadowsocks_Rust is not set
# CONFIG_PACKAGE_passwall_INCLUDE_NaiveProxy is not set

# 启用 sing-box 的轻量模式 / UPX
CONFIG_SING_BOX_BUILD_TINY=y